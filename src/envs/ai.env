# Backend configuration (LiteLLM Proxy)
ENABLE_OPENAI_API=True
OPENAI_API_BASE_URL=https://llm.ai.intranet.xbhl.online/v1
OPENAI_API_KEY=PLACEHOLDER

# Disable default Ollama endpoint (LiteLLM is the single source of truth)
ENABLE_OLLAMA_API=False

# Sub-agents configuration
ENABLE_SUBAGENTS=True
SUBAGENTS_MAX_CONCURRENT=20
SUBAGENTS_MAX_ASYNC=20

# Audio (STT / TTS) configuration -> LiteLLM
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=https://llm.ai.intranet.xbhl.online/v1
AUDIO_STT_OPENAI_API_KEY=PLACEHOLDER
AUDIO_STT_MODEL=xbhl/transcribe

AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=https://llm.ai.intranet.xbhl.online/v1
AUDIO_TTS_OPENAI_API_KEY=PLACEHOLDER
AUDIO_TTS_MODEL=xbhl/tts
AUDIO_TTS_VOICE=alloy

# Image generation & editing configuration -> LiteLLM
ENABLE_IMAGE_GENERATION=True
IMAGE_GENERATION_ENGINE=openai
IMAGES_OPENAI_API_BASE_URL=https://llm.ai.intranet.xbhl.online/v1
IMAGES_OPENAI_API_KEY=PLACEHOLDER
IMAGE_GENERATION_MODEL=xbhl/image
IMAGE_SIZE=1024x1024
ENABLE_IMAGE_EDIT=True
IMAGE_EDIT_ENGINE=openai

# RAG Embeddings configuration -> LiteLLM
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=https://llm.ai.intranet.xbhl.online/v1
RAG_OPENAI_API_KEY=PLACEHOLDER
RAG_EMBEDDING_MODEL=xbhl/embed

# Web search configuration (SearXNG)
ENABLE_WEB_SEARCH=True
ENABLE_SEARCH_QUERY_GENERATION=True
WEB_SEARCH_RESULT_COUNT=5
WEB_LOADER_CONCURRENT_REQUESTS=10
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=https://search.intranet.xbhl.online/search?q=<query>

# Tool Servers / MCP configuration (XBHL.online MCP Gateway via Bearer Auth)
ENABLE_TOOL_SERVERS=True
TOOL_SERVER_CONNECTIONS=
